{
  "name": "@battlegame/game-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic game engine for BattleGame - server and client compatible",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/gameConfig.d.ts",
      "import": "./dist/config/gameConfig.js"
    },
    "./types": {
      "types": "./dist/engine/types.d.ts",
      "import": "./dist/engine/types.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}