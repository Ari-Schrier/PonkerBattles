{
  "name": "@battlegame/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn-based tactical skirmish game built with Phaser - monorepo root",
  "workspaces": [
    "packages/game-core",
    "packages/game-client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@battlegame/game-client",
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace=@battlegame/game-core",
    "build:client": "npm run build --workspace=@battlegame/game-client",
    "preview": "npm run preview --workspace=@battlegame/game-client",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^3.2.4"
  }
}